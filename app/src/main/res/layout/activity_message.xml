<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:paddingTop="15dp"
    tools:context=".message">

    <!-- ===== TOP BAR ===== -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/backArrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/back_arrow_head"
            android:layout_alignParentStart="true" />

        <TextView
            android:id="@+id/chatName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/backArrow"
            android:layout_marginLeft="15dp"
            android:text="Tabarak"
            android:textColor="@color/black"
            android:textSize="19sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- ===== CHAT MESSAGES SCROLL ===== -->
    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@id/messageBar"
        android:paddingHorizontal="16dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== DATE LABEL ===== -->
            <TextView
                android:id="@+id/dateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Today"
                android:textColor="@color/textgrey"
                android:textSize="12sp"
                android:layout_marginVertical="8dp" />

            <!-- ===== RECEIVED MESSAGE ===== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/grey_msg_bg"
                android:padding="12dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="60dp"
                android:layout_gravity="start">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hello John,
Kindly let me know when will you be available for the bi-weekly meeting."
                    android:textColor="@color/black"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ===== SENT MESSAGE 1 ===== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/blue_msg_bg"
                android:padding="12dp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="60dp"
                android:layout_gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hey,
So I'll be available tomorrow around 10PM. Kindly send me the meeting agenda."
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ===== SENT MESSAGE 2 ===== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/blue_msg_bg"
                android:padding="12dp"
                android:layout_marginTop="6dp"
                android:layout_marginStart="60dp"
                android:layout_gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Also please share the exact meeting venue"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ===== MESSAGE INPUT BAR ===== -->
    <LinearLayout
        android:id="@+id/messageBar"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:gravity="center_vertical"
        android:background="@drawable/bg_bottom_nav_round"
        android:elevation="6dp">

        <EditText
            android:id="@+id/msgInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Send message"
            android:background="@drawable/send_msg_border"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="@color/black"
            android:textColorHint="@color/textgrey"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/btnAttach"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/highlight" />

        <ImageView
            android:id="@+id/btnHeart"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/like" />

        <ImageView
            android:id="@+id/btnSend"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/send" />
    </LinearLayout>
</RelativeLayout>
