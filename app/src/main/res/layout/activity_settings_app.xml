<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/app_settings_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".settings_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:id="@+id/back_arrow"
                    android:src="@drawable/back_arrow"
                    android:layout_marginTop="-4dp"/>

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back"
                android:textColor="@color/bluebg"
                android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/app_settings_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="App settings"

                android:textColor="@android:color/black"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center" />

            <ImageView
                android:id="@+id/settings_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="8dp" />

        <!-- Background Audio -->
        <TextView
            android:id="@+id/background_audio_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Background audio"
            android:textSize="18dp"
            android:textColor="@color/bluebg"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:id="@+id/background_audio_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                >

                <TextView
                    android:id="@+id/background_audio_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Continue Playback Background"
                    android:textColor="@android:color/black"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/background_audio_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enable this setting if you'd like to continue to listen music while using app"
                    android:textColor="#888888"
                    android:textSize="12sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_background_audio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="@color/bluebg"
                android:trackTint="#D0D0D0" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0" />

        <!-- Cellular Data -->
        <TextView
            android:id="@+id/cellular_data_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cellular Data"
            android:textSize="18dp"
            android:textColor="@color/bluebg"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:id="@+id/cellular_data_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/cellular_data_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                
                android:text="Cellular Data for Downloads"
                android:textColor="@android:color/black"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switch_cellular_data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="#D0D0D0"
                android:trackTint="#D0D0D0" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0" />

        <!-- Application Quality -->
        <TextView
            android:id="@+id/application_quality_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Application quality"
            android:textColor="@color/bluebg"
            android:textSize="18dp"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <!-- Standard -->
        <LinearLayout
            android:id="@+id/quality_standard_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp">
            

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                >

                <TextView
                    android:id="@+id/quality_standard_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Standard (recommended)"
                    android:textColor="@android:color/black"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/quality_standard_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Faster and uses less storage"
                    android:textColor="#888888"
                    android:textSize="12sp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/checkbox_standard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/bluebg"
                android:checked="true" />
        </LinearLayout>
        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0" />

        <!-- High Definition -->
        <LinearLayout
            android:id="@+id/quality_high_def_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
           android:paddingVertical="12dp">
            

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                >

                <TextView
                    android:id="@+id/quality_highdef_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="High Definition"
                    android:textColor="@android:color/black"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/quality_highdef_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Uses more storage"
                    android:textColor="#888888"
                    android:textSize="12sp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/checkbox_highdef"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="@color/black"
                android:buttonTint="#D0D0D0" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0" />

        <!-- Application Theme -->
        <TextView
            android:id="@+id/application_theme_header"
            android:layout_width="wrap_content"
            android:textSize="18dp"
            android:layout_height="wrap_content"
            android:text="Application Theme"
            android:textColor="@color/bluebg"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:id="@+id/application_theme_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
           android:paddingVertical="12dp">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                >

                <TextView
                    android:id="@+id/application_theme_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dark Mood"
                    android:textColor="@android:color/black"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/application_theme_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enable this setting if you'd like to continue using app in dark mood"
                    android:textColor="#888888"
                    android:textSize="12sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_darkmode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="@color/bluebg"
                android:trackTint="#D0D0D0" />
        </LinearLayout>

        <!-- Final Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
