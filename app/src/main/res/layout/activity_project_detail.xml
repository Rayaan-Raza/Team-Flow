<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#2F6CE5"
    tools:context=".project_detail">

    <!-- Top bar -->
    <RelativeLayout
        android:layout_marginTop="15dp"
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/back_arrow"
            />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:text="Project Detail"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/btnEdit"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:src="@drawable/edit"
            app:tint="#FFFFFF" />
    </RelativeLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@id/topBar"
        android:layout_above="@+id/bottomNav"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Project card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_round"
                android:padding="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/projectTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Green sky Website Dev"
                    android:textColor="#2F6CE5"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/projectDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="GreenSky DG focuses on evaluating and developing solar opportunities for landholders"
                    android:textColor="#6B7280"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/dueDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Due date:  Sunday,  5 October 2025"
                    android:textColor="#111827"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Assigned to -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_round"
                android:padding="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assigned to"
                    android:textColor="#111827"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <!-- Avatar 1 -->
                    <ImageView
                        android:id="@+id/avatar1"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="0dp"
                        android:layout_alignParentStart="true"
                        android:src="@drawable/pfp1"
                        android:background="@drawable/bg_circle_mask"
                        android:scaleType="centerCrop" />

                    <!-- Avatar 2 -->
                    <ImageView
                        android:id="@+id/avatar2"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/avatar1"
                        android:layout_marginStart="20dp"
                        android:src="@drawable/pfp2"
                        android:background="@drawable/bg_circle_mask"
                        android:scaleType="centerCrop" />

                    <!-- Avatar 3 -->
                    <ImageView
                        android:id="@+id/avatar3"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/avatar2"
                        android:layout_marginStart="20dp"
                        android:src="@drawable/pfp3"
                        android:background="@drawable/bg_circle_mask"
                        android:scaleType="centerCrop" />

                    <!-- Avatar 4 -->
                    <ImageView
                        android:id="@+id/avatar4"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/avatar3"
                        android:layout_marginStart="20dp"
                        android:src="@drawable/pfp4"
                        android:background="@drawable/bg_circle_mask"
                        android:scaleType="centerCrop" />

                    <!-- Avatar 5 -->
                    <ImageView
                        android:id="@+id/avatar5"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/avatar4"
                        android:layout_marginStart="20dp"
                        android:src="@drawable/pfp5"
                        android:background="@drawable/bg_circle_mask"
                        android:scaleType="centerCrop" />

                    <!-- Plus button -->
                    <RelativeLayout
                        android:id="@+id/addAvatar"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/avatar5"
                        android:layout_marginStart="20dp"
                        android:background="@drawable/bg_circle_stroke">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_centerInParent="true"
                            android:src="@drawable/plus"
                            app:tint="#2F6CE5" />
                    </RelativeLayout>
                </RelativeLayout>
            </LinearLayout>

            <!-- Task list card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_round"
                android:padding="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Task"
                    android:textColor="#111827"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <!-- item 1 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="6dp">

                    <ImageView
                        android:id="@+id/chk1"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/circle_check"
                        android:src="@drawable/tick"
                        android:padding="6dp"

                      />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/chk1"
                        android:layout_marginStart="10dp"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:text="Create Design System"
                            android:textColor="#111827"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="2dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/flag"
                               />

                            <TextView
                                android:text=" 25 hr"
                                android:textColor="#9CA3AF"
                                android:textSize="11sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- right avatars -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:orientation="horizontal">

                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/pfp1" android:background="@drawable/bg_circle_mask" android:scaleType="centerCrop"/>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:layout_marginStart="-8dp" android:src="@drawable/pfp2" android:background="@drawable/bg_circle_mask" android:scaleType="centerCrop"/>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:layout_marginStart="-8dp" android:src="@drawable/pfp3" android:background="@drawable/bg_circle_mask" android:scaleType="centerCrop"/>
                    </LinearLayout>
                </RelativeLayout>

                <!-- item 2 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="2dp">

                    <ImageView
                        android:id="@+id/chk2"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/circle_check"
                        android:src="@drawable/tick"
                        android:padding="6dp"
                      />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/chk2"
                        android:layout_marginStart="10dp"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:text="Create Wireframe"
                            android:textColor="#111827"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="2dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/flag"
                                />

                            <TextView
                                android:text=" 18 hr"
                                android:textColor="#9CA3AF"
                                android:textSize="11sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:orientation="horizontal">

                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/pfp4" android:background="@drawable/bg_circle_mask" android:scaleType="centerCrop"/>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:layout_marginStart="-8dp" android:src="@drawable/pfp5" android:background="@drawable/bg_circle_mask" android:scaleType="centerCrop"/>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:layout_marginStart="-8dp" android:src="@drawable/pfp2" android:background="@drawable/bg_circle_mask" android:scaleType="centerCrop"/>
                    </LinearLayout>
                </RelativeLayout>

                <!-- item 3 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="2dp">

                    <ImageView
                        android:id="@+id/radio3"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/bg_circle_mask"
                        />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/radio3"
                        android:layout_marginStart="10dp"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:text="Landing Page Design"
                            android:textColor="#111827"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="2dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/flag"
                               />

                            <TextView
                                android:text=" 8 hr"
                                android:textColor="#9CA3AF"
                                android:textSize="11sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_alignParentEnd="true" android:layout_centerVertical="true"
                        android:src="@drawable/pfp3" android:background="@drawable/bg_circle_mask" android:scaleType="centerCrop"/>
                </RelativeLayout>

                <!-- item 4 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="2dp">

                    <ImageView
                        android:id="@+id/radio4"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/bg_circle_mask"
                        />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/radio4"
                        android:layout_marginStart="10dp"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:text="Mobile Screen Design"
                            android:textColor="#111827"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="2dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/flag"
                               />

                            <TextView
                                android:text=" 40 hr"
                                android:textColor="#9CA3AF"
                                android:textSize="11sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:orientation="horizontal">

                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/pfp1" android:background="@drawable/bg_circle_mask" android:scaleType="centerCrop"/>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:layout_marginStart="-8dp" android:src="@drawable/pfp4" android:background="@drawable/bg_circle_mask" android:scaleType="centerCrop"/>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:layout_marginStart="-8dp" android:src="@drawable/pfp5" android:background="@drawable/bg_circle_mask" android:scaleType="centerCrop"/>
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom nav (placeholder) -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="8dp">

        <!-- one item -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/home_unselect"
                />


        </LinearLayout>

        <!-- others -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/project"
                android:tint="@color/black"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/calendar_unselect"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/inbox_unselect"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/profile_unselect"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
