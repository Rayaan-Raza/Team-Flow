<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2F6CE5">

    <!-- Top bar -->
    <RelativeLayout
        android:layout_marginTop="20dp"
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/back_arrow" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:text="Task Detail"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/edit"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/edit"
            android:backgroundTint="@color/white"
            android:padding="6dp"

            />
    </RelativeLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@id/topBar"
        android:layout_above="@+id/bottomNav"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Project intro card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_round_stroke"
                android:padding="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Project Title"
                    android:textColor="#2F6CE5"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Here goes a brief explanation for the project that the added people (assigned to) will have to complete till mentioned due date"
                    android:textColor="#6B7280"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Due date:  Sunday,  5 October 2025"
                    android:textColor="#111827"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Assigned to card -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_round"
                android:padding="12dp">

                <TextView
                    android:id="@+id/assignedLbl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assigned to"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:textSize="13sp" />

                <!-- evenly spaced avatars -->
                <RelativeLayout
                    android:id="@+id/avatarsRow"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_below="@id/assignedLbl"
                    android:layout_marginTop="8dp">

                    <!-- 5 avatars + add -->
                    <ImageView
                        android:id="@+id/av1"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:src="@drawable/pfp1"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_avatar_round"
                        android:clipToOutline="true"/>

                    <ImageView
                        android:id="@+id/av2"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/av1"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/pfp2"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_avatar_round"
                        android:clipToOutline="true"/>

                    <ImageView
                        android:id="@+id/av3"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/av2"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/pfp3"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_avatar_round"
                        android:clipToOutline="true"/>

                    <ImageView
                        android:id="@+id/av4"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/av3"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/pfp4"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_avatar_round"
                        android:clipToOutline="true"/>

                    <ImageView
                        android:id="@+id/av5"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/av4"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/pfp5"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_avatar_round"
                        android:clipToOutline="true"/>

                    <RelativeLayout
                        android:id="@+id/addMember"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_circle_stroke">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_centerInParent="true"
                            android:src="@drawable/plus"
                            app:tint="#2F6CE5" />
                    </RelativeLayout>
                </RelativeLayout>
            </RelativeLayout>

            <!-- Task card (list) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_round"
                android:padding="12dp">

                <TextView
                    android:id="@+id/taskLbl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Task"
                    android:textColor="#111827"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <RelativeLayout
                    android:id="@+id/addTask"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_circle_stroke">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_centerInParent="true"
                        android:src="@drawable/plus"
                        />
                </RelativeLayout>

                <!-- One task row example (repeat as needed) -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_below="@id/taskLbl"
                    android:layout_marginTop="6dp">

                    <ImageView
                        android:id="@+id/radio1"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/bg_circle_mask"
                        />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/radio1"
                        android:layout_marginStart="10dp"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:text="Create Design System"
                            android:textColor="#111827"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="2dp">
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/flag"
                                />
                            <TextView
                                android:text=" 25 hr"
                                android:textColor="#9CA3AF"
                                android:textSize="11sp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- right avatars (CIRCULAR) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/pfp1"
                            android:scaleType="centerCrop"
                            android:background="@drawable/bg_avatar_round"
                            android:clipToOutline="true"/>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="-6dp"
                            android:src="@drawable/pfp2"
                            android:scaleType="centerCrop"
                            android:background="@drawable/bg_avatar_round"
                            android:clipToOutline="true"/>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="-6dp"
                            android:src="@drawable/pfp3"
                            android:scaleType="centerCrop"
                            android:background="@drawable/bg_avatar_round"
                            android:clipToOutline="true"/>
                    </LinearLayout>
                </RelativeLayout>

                <!-- Duplicate more rows similarly... -->

            </RelativeLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom nav placeholder -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="8dp">

        <!-- one item -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/home_unselect"
                />


        </LinearLayout>

        <!-- others -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/project"
                android:tint="@color/black"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/calendar_unselect"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/inbox_unselect"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/profile_unselect"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
