<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:paddingTop="15dp"
    tools:context=".inbox_all">

    <!-- ===== TOP BAR ===== -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/backArrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/back_arrow_head"
            android:layout_alignParentStart="true" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/backArrow"
            android:layout_marginLeft="15dp"
            android:text="Inbox"
            android:textColor="@color/black"
            android:textSize="19sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- ===== TABS ===== -->
    <LinearLayout
        android:id="@+id/tabLayout"
        android:layout_below="@id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="24dp">

        <TextView
            android:id="@+id/tabAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="All"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tabUnread"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Unread"
            android:textColor="@color/textgrey"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tabRead"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Read"
            android:textColor="@color/textgrey"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- ===== BLUE LINE UNDER ALL ===== -->
    <LinearLayout
        android:id="@+id/tabUnderlineRow"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_below="@id/tabLayout"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="24dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/bluebg" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent" />
    </LinearLayout>

    <!-- ===== CONVERSATIONS LIST ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvConversations"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tabUnderlineRow"
        android:layout_above="@id/bottomNav"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:clipToPadding="false" />

    <!-- ===== BOTTOM NAVIGATION ===== -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:weightSum="5"
        android:background="@drawable/bg_bottom_nav_round"
        android:elevation="8dp"
        android:paddingVertical="8dp">

        <LinearLayout 
            android:id="@+id/navHome"
            android:layout_width="0dp" 
            android:layout_height="match_parent" 
            android:layout_weight="1" 
            android:gravity="center">
            <ImageView 
                android:layout_width="match_parent" 
                android:layout_height="match_parent" 
                android:layout_margin="10dp" 
                android:src="@drawable/home_unselect"/>
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/navProjects"
            android:layout_width="0dp" 
            android:layout_height="match_parent" 
            android:layout_weight="1" 
            android:gravity="center">
            <ImageView 
                android:layout_width="match_parent" 
                android:layout_height="match_parent" 
                android:layout_margin="10dp" 
                android:src="@drawable/project_unselect"/>
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/navCalendar"
            android:layout_width="0dp" 
            android:layout_height="match_parent" 
            android:layout_weight="1" 
            android:gravity="center">
            <ImageView 
                android:layout_width="match_parent" 
                android:layout_height="match_parent" 
                android:layout_margin="10dp" 
                android:src="@drawable/logo_main"/>
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/navInbox"
            android:layout_width="0dp" 
            android:layout_height="match_parent" 
            android:layout_weight="1" 
            android:gravity="center">
            <ImageView 
                android:layout_width="match_parent" 
                android:layout_height="match_parent" 
                android:layout_margin="10dp" 
                android:src="@drawable/inbox_selected"/>
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/navProfile"
            android:layout_width="0dp" 
            android:layout_height="match_parent" 
            android:layout_weight="1" 
            android:gravity="center">
            <ImageView 
                android:layout_width="match_parent" 
                android:layout_height="match_parent" 
                android:layout_margin="10dp" 
                android:src="@drawable/profile_unselect"/>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
