<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:paddingTop="15dp"
    tools:context=".inbox_all">

    <!-- ===== TOP BAR ===== -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/backArrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/back_arrow_head"
            android:layout_alignParentStart="true" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/backArrow"
            android:layout_marginLeft="15dp"
            android:text="Inbox"
            android:textColor="@color/black"
            android:textSize="19sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- ===== SEARCH BAR ===== -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_below="@id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_round"
            android:paddingHorizontal="16dp"
            android:hint="Search by name or email..."
            android:textColorHint="@color/textgrey"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:inputType="text"
            android:maxLines="1"
            android:imeOptions="actionSearch" />
    </LinearLayout>

    <!-- ===== CONVERSATIONS LIST ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvConversations"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/searchContainer"
        android:layout_above="@id/bottomNav"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:clipToPadding="false" />

    <!-- ===== BOTTOM NAVIGATION ===== -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:weightSum="5"
        android:background="@drawable/bg_bottom_nav_round"
        android:elevation="8dp"
        android:paddingVertical="8dp">

        <LinearLayout 
            android:id="@+id/navHome"
            android:layout_width="0dp" 
            android:layout_height="match_parent" 
            android:layout_weight="1" 
            android:gravity="center">
            <ImageView 
                android:layout_width="match_parent" 
                android:layout_height="match_parent" 
                android:layout_margin="10dp" 
                android:src="@drawable/home_unselect"/>
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/navProjects"
            android:layout_width="0dp" 
            android:layout_height="match_parent" 
            android:layout_weight="1" 
            android:gravity="center">
            <ImageView 
                android:layout_width="match_parent" 
                android:layout_height="match_parent" 
                android:layout_margin="10dp" 
                android:src="@drawable/project_unselect"/>
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/navCalendar"
            android:layout_width="0dp" 
            android:layout_height="match_parent" 
            android:layout_weight="1" 
            android:gravity="center">
            <ImageView 
                android:layout_width="match_parent" 
                android:layout_height="match_parent" 
                android:layout_margin="10dp" 
                android:src="@drawable/logo_main"/>
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/navInbox"
            android:layout_width="0dp" 
            android:layout_height="match_parent" 
            android:layout_weight="1" 
            android:gravity="center">
            <ImageView 
                android:layout_width="match_parent" 
                android:layout_height="match_parent" 
                android:layout_margin="10dp" 
                android:src="@drawable/inbox_selected"/>
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/navProfile"
            android:layout_width="0dp" 
            android:layout_height="match_parent" 
            android:layout_weight="1" 
            android:gravity="center">
            <ImageView 
                android:layout_width="match_parent" 
                android:layout_height="match_parent" 
                android:layout_margin="10dp" 
                android:src="@drawable/profile_unselect"/>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
